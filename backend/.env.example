# Povezava do podatkovne baze (Docker Compose v korenu projekta)
DATABASE_URL="postgresql://zalivaj:zalivaj@localhost:5432/zalivaj?schema=public"

# Ključ za podpisovanje žetonov JWT – v produkciji uporabite dolg naključen niz
JWT_SECRET="spremeni-me-v-dolg-nakljucen-niz"

# Čas veljavnosti žetona
JWT_EXPIRES_IN="8h"

PORT=3000
