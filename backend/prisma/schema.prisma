generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Light {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  OPEN
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  DONE
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(USER)
  location     String   @db.VarChar(150)
  isBlocked    Boolean  @default(false) @map("is_blocked")
  createdAt    DateTime @default(now()) @map("created_at")

  plants        Plant[]
  ownedRequests SittingRequest[] @relation("OwnerRequests")
  sittings      SittingRequest[] @relation("SitterRequests")
  applications  Application[]
  reviewsGiven  Review[]         @relation("ReviewAuthor")
  reviews       Review[]         @relation("ReviewSitter")

  @@map("users")
}

model Plant {
  id                String   @id @default(uuid()) @db.Uuid
  ownerId           String   @map("owner_id") @db.Uuid
  name              String   @db.VarChar(100)
  species           String?  @db.VarChar(100)
  wateringEveryDays Int      @map("watering_every_days")
  waterAmountMl     Int?     @map("water_amount_ml")
  light             Light?
  notes             String?
  photoUrl          String?  @map("photo_url") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")

  owner    User           @relation(fields: [ownerId], references: [id])
  requests RequestPlant[]
  tasks    WateringTask[]

  @@map("plants")
}

model SittingRequest {
  id        String        @id @default(uuid()) @db.Uuid
  ownerId   String        @map("owner_id") @db.Uuid
  startDate DateTime      @map("start_date") @db.Date
  endDate   DateTime      @map("end_date") @db.Date
  location  String        @db.VarChar(150)
  note      String?
  status    RequestStatus @default(OPEN)
  sitterId  String?       @map("sitter_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  owner        User           @relation("OwnerRequests", fields: [ownerId], references: [id])
  sitter       User?          @relation("SitterRequests", fields: [sitterId], references: [id])
  plants       RequestPlant[]
  applications Application[]
  tasks        WateringTask[]
  review       Review?

  @@map("sitting_requests")
}

model RequestPlant {
  requestId String @map("request_id") @db.Uuid
  plantId   String @map("plant_id") @db.Uuid

  request SittingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  plant   Plant          @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@id([requestId, plantId])
  @@map("request_plants")
}

model Application {
  id        String            @id @default(uuid()) @db.Uuid
  requestId String            @map("request_id") @db.Uuid
  sitterId  String            @map("sitter_id") @db.Uuid
  message   String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")

  request SittingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sitter  User           @relation(fields: [sitterId], references: [id])

  @@unique([requestId, sitterId])
  @@map("applications")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @unique @map("request_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  sitterId  String   @map("sitter_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  request SittingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation("ReviewAuthor", fields: [authorId], references: [id])
  sitter  User           @relation("ReviewSitter", fields: [sitterId], references: [id])

  @@map("reviews")
}

model WateringTask {
  id        String     @id @default(uuid()) @db.Uuid
  requestId String     @map("request_id") @db.Uuid
  plantId   String     @map("plant_id") @db.Uuid
  dueDate   DateTime   @map("due_date") @db.Date
  status    TaskStatus @default(PENDING)
  doneAt    DateTime?  @map("done_at")
  note      String?

  request SittingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  plant   Plant          @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([requestId, dueDate])
  @@map("watering_tasks")
}
